# Template for secret.hcl. Copy it and fill in real values:
#
#   cp secret.hcl.example secret.hcl
#
# secret.hcl is git-ignored. Every local defined here is passed to every unit
# as an input, so a module only needs to declare the `variable` it consumes.

locals {
  # Cloudflare API token for cert-manager DNS-01.
  # Perms: Zone:DNS:Edit + Zone:Zone:Read, scoped to your zone.
  cloudflare_api_token = ""

  # htpasswd entry ("user:hash") for ingress-nginx basic auth in front of
  # Headlamp. Empty string = no basic auth. Generate with:
  #   htpasswd -nbBC 10 <user> <password>
  headlamp_basic_auth_htpasswd = ""

  # Kargo admin account. Hash: bcrypt of the admin password, e.g.
  #   htpasswd -nbB admin <password> | cut -d: -f2 | sed 's/\$2y/\$2a/'
  kargo_admin_password_hash = ""
  # Token signing key, e.g.  openssl rand -base64 29 | tr -d "=+/" | cut -c1-32
  kargo_token_signing_key = ""

  # Argo CD admin password (bcrypt). Empty = chart generates one
  # (kubectl -n argocd get secret argocd-initial-admin-secret). Hash:
  #   htpasswd -nbBC 10 "" <password> | tr -d ':\n' | sed 's/$2y/$2a/'
  argocd_admin_password_bcrypt = ""
}
